    <bpmn:association id="Association_0670lnq" associationDirection="None" sourceRef="id9b9067fe-91c2-4346-8480-13b5c849625f" targetRef="TextAnnotation_1k19c18" />
    <bpmn:textAnnotation id="TextAnnotation_16x68vy">
      <bpmn:text>p = 0.89</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1cgn5gq" associationDirection="None" sourceRef="id62e80c11-ca80-4dde-a18c-a362bc972b1b" targetRef="TextAnnotation_16x68vy" />
    <bpmn:textAnnotation id="TextAnnotation_0c73fwr">
      <bpmn:text>p = 0.08</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_005veab" associationDirection="None" sourceRef="id521b4617-44cf-4593-85d7-8d81a64d628b" targetRef="TextAnnotation_0c73fwr" />
    <bpmn:textAnnotation id="TextAnnotation_11hcf0n">
      <bpmn:text>p = 0.92</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1c5v7rf" associationDirection="None" sourceRef="id6e7306ab-bbb7-4d0d-92ea-09d479af8168" targetRef="TextAnnotation_11hcf0n" />
    <bpmn:textAnnotation id="TextAnnotation_143dbpx">
      <bpmn:text>waiting_days &lt;= 0 AND visit &lt;= 1 AND LoanGoal != Unknown (p = 0.14)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1o7en82" associationDirection="None" sourceRef="idedd43dcd-70f4-4c02-b3f0-1f0ebb3147c5" targetRef="TextAnnotation_143dbpx" />
    <bpmn:textAnnotation id="TextAnnotation_01mxco3">
      <bpmn:text>(waiting_days &gt;= 1 (or missing)) OR (waiting_days &lt;= 0 AND visit &gt;= 2) OR (waiting_days &lt;= 0 AND visit &lt;= 1 AND LoanGoal = Unknown) (p = 0.86)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0j6nr11" associationDirection="None" sourceRef="iddf8d83ce-d4c2-4e24-a80e-c00684b80087" targetRef="TextAnnotation_01mxco3" />
    <bpmn:textAnnotation id="TextAnnotation_1i4aqt8">
      <bpmn:text>waiting_days &lt;= 29 (p = 0.69)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1jv01ko" associationDirection="None" sourceRef="idded17e04-64a3-4d60-abc1-6cb8d1683709" targetRef="TextAnnotation_1i4aqt8" />
    <bpmn:textAnnotation id="TextAnnotation_1c7y5bf">
      <bpmn:text>waiting_days &gt;= 30 (or missing) (p = 0.31)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_15dqn2c" associationDirection="None" sourceRef="id20796a60-685b-42d1-b59d-cd0ea8cf3ad3" targetRef="TextAnnotation_1c7y5bf" />
    <bpmn:textAnnotation id="TextAnnotation_06q1bcu">
      <bpmn:text>(waiting_days &lt;= 0 (or missing) AND start_month &lt;= 6) OR (waiting_days &lt;= 0 (or missing) AND start_month &gt;= 7 AND ApplicationType = Limit raise) OR (waiting_days &gt;= 1 AND visit &gt;= 2 AND ApplicationType != New credit) (p = 0.41)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0xsyd8m" associationDirection="None" sourceRef="id11189c16-5750-412c-95c7-1cdb93cd7605" targetRef="TextAnnotation_06q1bcu" />
    <bpmn:textAnnotation id="TextAnnotation_1jtzmwt">
      <bpmn:text>(waiting_days &lt;= 0 (or missing) AND start_month &gt;= 7 AND ApplicationType != Limit raise) OR (waiting_days &gt;= 1 AND visit &lt;= 1) OR (waiting_days &gt;= 1 AND visit &gt;= 2 AND ApplicationType = New credit) (p = 0.59)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1dda8ni" associationDirection="None" sourceRef="id6d1f6b18-36b2-4091-aa82-7cb2e515401d" targetRef="TextAnnotation_1jtzmwt" />
    <bpmn:textAnnotation id="TextAnnotation_1jzg4h0">
      <bpmn:text>(visit &lt;= 1 AND waiting_days &lt;= 1 AND org:resource != User_112) OR (visit &lt;= 1 AND waiting_days &gt;= 2 (or missing) AND start_month &gt;= 12) (p = 0.44)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_031nipk" associationDirection="None" sourceRef="id2592c65d-fa9d-4eb3-bffe-b97d40d6fcb3" targetRef="TextAnnotation_1jzg4h0" />
    <bpmn:textAnnotation id="TextAnnotation_1d1gjpt">
      <bpmn:text>(visit &gt;= 2) OR (visit &lt;= 1 AND waiting_days &gt;= 2 (or missing) AND start_month &lt;= 11) OR (visit &lt;= 1 AND waiting_days &lt;= 1 AND org:resource = User_112) (p = 0.56)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1tqowt6" associationDirection="None" sourceRef="id4280e0ce-758f-4b13-94a1-c2d97d8f806b" targetRef="TextAnnotation_1d1gjpt" />
    <bpmn:textAnnotation id="TextAnnotation_0f8kqhc">
      <bpmn:text>no rule (p = 0.12)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_17e37ga" associationDirection="None" sourceRef="id4f4aafa7-9fe8-4576-9ecb-dea297ac698a" targetRef="TextAnnotation_0f8kqhc" />
    <bpmn:textAnnotation id="TextAnnotation_0pw1uf7">
      <bpmn:text>(waiting_days &lt;= 20 AND elapsed_days &gt;= 6 (or missing)) OR (waiting_days &lt;= 1 AND elapsed_days &lt;= 5) (p = 0.55)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1lwx5xg" associationDirection="None" sourceRef="id7693495f-27d6-4b97-bf45-68fed1202b66" targetRef="TextAnnotation_0pw1uf7" />
    <bpmn:textAnnotation id="TextAnnotation_18dj5fs">
      <bpmn:text>(waiting_days &gt;= 21 (or missing)) OR (2 &lt;= waiting_days &lt;= 20 AND elapsed_days &lt;= 5) (p = 0.33)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0whstm9" associationDirection="None" sourceRef="id70708e1a-83ca-4c05-907c-25ef1bbbf0d1" targetRef="TextAnnotation_18dj5fs" />
    <bpmn:textAnnotation id="TextAnnotation_1j94orn">
      <bpmn:text>org:resource = User_1 (p = 0.53)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ek2urh" associationDirection="None" sourceRef="id22f2e026-c070-4822-8f2a-8714e684fa50" targetRef="TextAnnotation_1j94orn" />
    <bpmn:textAnnotation id="TextAnnotation_1edowm3">
      <bpmn:text>org:resource != User_1 (p = 0.47)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1g8wvr0" associationDirection="None" sourceRef="id56ba90d5-3d7f-461b-9be8-500618603054" targetRef="TextAnnotation_1edowm3" />
    <bpmn:textAnnotation id="TextAnnotation_17034i0">
      <bpmn:text>p = 0.22</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0az48ps" associationDirection="None" sourceRef="idb8daf9e4-6dd0-4bcc-a2a1-ffcf657a29c2" targetRef="TextAnnotation_17034i0" />
    <bpmn:textAnnotation id="TextAnnotation_0hn7rr1">
      <bpmn:text>p = 0.78</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ort438" associationDirection="None" sourceRef="id80bd2ff6-919d-4151-b188-dd12319362b5" targetRef="TextAnnotation_0hn7rr1" />
  </bpmn:process>
